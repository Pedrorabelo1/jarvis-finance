generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  categorias               Categoria[]
  lancamentos              Lancamento[]
  fixas                    DespesaFixa[]
  investimentos            Investimento[]
  configuracoes            Configuracao[]
  regrasDestinatario       RegraDestinatario[]
  rentabilidadeConfigs     RentabilidadeConfig[]
  metaInvestimento         MetaInvestimento?
  categoriasInvestimento   CategoriaInvestimento[]
  rendimentosMensais       RendimentoMensal[]
}

model Categoria {
  id        String   @id @default(cuid())
  userId    String
  nome      String
  tipo      String
  icone     String
  cor       String
  orcamento Float?
  descricao String?
  createdAt DateTime @default(now())

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  lancamentos        Lancamento[]
  fixas              DespesaFixa[]
  regrasDestinatario RegraDestinatario[]

  @@index([userId])
}

model Lancamento {
  id           String   @id @default(cuid())
  userId       String
  descricao    String
  valor        Float
  tipo         String
  data         DateTime
  categoriaId  String
  tags         String?
  parcelas     Int?
  parcelaAtual Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoria Categoria @relation(fields: [categoriaId], references: [id])

  @@index([userId])
  @@index([data])
  @@index([categoriaId])
}

model DespesaFixa {
  id            String    @id @default(cuid())
  userId        String
  descricao     String
  valor         Float
  diaVencimento Int
  categoriaId   String
  dataInicio    DateTime
  dataFim       DateTime?
  status        String    @default("ativa")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoria Categoria        @relation(fields: [categoriaId], references: [id])
  historico HistoricoValor[]

  @@index([userId])
}

model HistoricoValor {
  id            String   @id @default(cuid())
  despesaFixaId String
  valor         Float
  dataAlteracao DateTime @default(now())

  despesaFixa DespesaFixa @relation(fields: [despesaFixaId], references: [id], onDelete: Cascade)
}

model Investimento {
  id                    String   @id @default(cuid())
  userId                String
  descricao             String
  valor                 Float
  quantidadeBTC         Float?
  classe                String?  // legado — mantido para compatibilidade
  categoriaInvestimentoId String?
  data                  DateTime
  createdAt             DateTime @default(now())

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoriaInvestimento CategoriaInvestimento? @relation(fields: [categoriaInvestimentoId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([data])
}

model Configuracao {
  id     String @id @default(cuid())
  userId String
  chave  String
  valor  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chave])
  @@index([userId])
}

model RegraDestinatario {
  id          String   @id @default(cuid())
  userId      String
  padrao      String
  categoriaId String
  tipo        String
  descricao   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoria Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RentabilidadeConfig {
  id         String   @id @default(cuid())
  userId     String
  classe     String
  taxaMensal Float    @default(0)
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, classe])
  @@index([userId])
}

model MetaInvestimento {
  id             String   @id @default(cuid())
  userId         String   @unique
  aporteMensal   Float?
  patrimonioAlvo Float?
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Novo sistema de investimentos ──────────────────────────────────────────

model CategoriaInvestimento {
  id        String   @id @default(cuid())
  userId    String
  nome      String
  cor       String   @default("#3b82f6")
  icone     String   @default("📈")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  investimentos     Investimento[]
  rendimentosMensais RendimentoMensal[]

  @@index([userId])
}

model RendimentoMensal {
  id                      String   @id @default(cuid())
  userId                  String
  categoriaInvestimentoId String
  ano                     Int
  mes                     Int      // 1–12
  valorRendimento         Float?   // R$ absoluto
  percentual              Float?   // % do período
  observacao              String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoriaInvestimento CategoriaInvestimento @relation(fields: [categoriaInvestimentoId], references: [id], onDelete: Cascade)

  @@unique([userId, categoriaInvestimentoId, ano, mes])
  @@index([userId])
  @@index([categoriaInvestimentoId])
}
